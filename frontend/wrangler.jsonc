{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intern-atlas",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "d1_databases": [
    {
      "binding": "intern_atlas_db",
      "database_name": "intern-atlas-db",
      "database_id": "2e44edc5-46d3-4b67-8552-1b82958d2c2d",
      "remote": true
    }
  ],
  "build": {
    "command": "npx vite build"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": false
  }
}